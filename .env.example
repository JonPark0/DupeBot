# ─────────────────────────────────────────────
#  Discord
# ─────────────────────────────────────────────
# Developer Portal → Bot → Token / General Information → Application ID
DISCORD_TOKEN=
DISCORD_CLIENT_ID=

# ─────────────────────────────────────────────
#  PostgreSQL (its own container, see docker-compose.yml)
# ─────────────────────────────────────────────
# Used inside a URL: letters, digits, - and _ only.
POSTGRES_PASSWORD=change_me
POSTGRES_USER=dupebot
POSTGRES_DB=dupebot
# Only for `npm run dev` outside Docker (compose builds DATABASE_URL itself):
# DATABASE_URL=postgres://dupebot:change_me@localhost:5432/dupebot

# ─────────────────────────────────────────────
#  Detection defaults (per server, changeable with /dupe config)
# ─────────────────────────────────────────────
DEFAULT_EMOJI=🔁
DEFAULT_SEMANTIC_EMOJI=🤔
# forward (forward the original below the repost) | reply (reply with a link) | react (emoji only)
DEFAULT_MODE=forward
# Max differing bits (of 64) between two images' dHash to count as the same picture
DEFAULT_HAMMING_THRESHOLD=6
# A repost by the same author within this many minutes is ignored (0 = always flag)
DEFAULT_SAME_AUTHOR_MINUTES=10

# Days to keep fingerprints (hashes, IDs, link titles). Older ones are purged daily.
RETENTION_DAYS=90
# With a link-fixer bot listed (/dupe relay), wait this long before answering a member's post:
# the fixer usually deletes it and reposts the link, and only the repost should be answered.
RELAY_GRACE_MS=4000
# Images larger than this (bytes) or smaller than IMAGE_MIN_SIZE px on a side are skipped
IMAGE_MAX_BYTES=20971520
IMAGE_MIN_SIZE=64

# ─────────────────────────────────────────────
#  Claude semantic matching (optional)
# ─────────────────────────────────────────────
# Without a key this is off and everything else works as usual.
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-5-5
LLM_TIMEOUT_MS=10000
# Soft daily spend limit in USD (resets 00:00 UTC). 0 = no limit.
LLM_DAILY_BUDGET_USD=0.5
# Prices used for the budget (USD per million tokens)
LLM_PRICE_INPUT_PER_MTOK=0.1
LLM_PRICE_OUTPUT_PER_MTOK=0.5
# Flag only when Claude is at least this sure (0-1)
SEMANTIC_MIN_CONFIDENCE=0.85
# Compare against links from the last N days; send at most N candidates
SEMANTIC_WINDOW_DAYS=14
SEMANTIC_MAX_CANDIDATES=5
# Minimum pg_trgm similarity (0-1) for a link to be a candidate
SEMANTIC_MIN_SIMILARITY=0.15
# Links waiting for a Claude check; beyond this new ones are skipped
SEMANTIC_MAX_BACKLOG=20

# error | warn | info | debug
LOG_LEVEL=info
